{
  "name": "bong",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3210",
    "start": "next start --hostname 127.0.0.1 --port 3210",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "content:import": "tsx scripts/content.ts import",
    "content:validate": "tsx scripts/content.ts validate",
    "content:build": "tsx scripts/content.ts build",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test --project=chromium",
    "test:a11y": "playwright test --project=accessibility",
    "build": "npm run content:build && next build",
    "release:check": "tsx scripts/release-check.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "staff:manage": "node --conditions=react-server --import tsx scripts/staff.ts",
    "maintenance": "node --conditions=react-server --import tsx scripts/maintenance.ts",
    "assets:build": "tsx scripts/assets.ts",
    "format": "prettier --write src scripts tests *.ts *.mjs",
    "security:scan": "tsx scripts/secret-scan.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "csrf-csrf": "4.0.3",
    "next": "16.3.6",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.4",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.6",
    "prettier": "3.8.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  },
  "type": "module"
}
