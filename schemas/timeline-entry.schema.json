{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BONG timeline entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "status",
    "title",
    "revision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^BT-[A-Z0-9-]+$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 280
    },
    "dateLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "sortYear": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 9999
    },
    "datePrecision": {
      "enum": [
        "exact",
        "approximate",
        "range",
        "unknown"
      ]
    },
    "fictionText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "sourceIds"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1800
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        }
      }
    },
    "spark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "sourceIds"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1800
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "sourceIds"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1800
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    },
    "uncertaintyNote": {
      "type": "string",
      "maxLength": 1800
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "accessedAt",
          "supports"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "accessedAt": {
            "type": "string",
            "format": "date"
          },
          "supports": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "src",
        "alt",
        "credit",
        "rightsBasis",
        "rightsReviewedBy"
      ],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^/images/timeline/[A-Za-z0-9_/-]+\\.(?:webp|avif|png|jpg|jpeg)$"
        },
        "alt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "credit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "rightsBasis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "rightsReviewedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "reviewedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "reviewedAt": {
      "type": "string",
      "format": "date"
    },
    "correctionNote": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "required": [
          "summary",
          "dateLabel",
          "sortYear",
          "datePrecision",
          "fictionText",
          "facts",
          "spark",
          "development",
          "sources",
          "reviewedBy",
          "reviewedAt"
        ]
      }
    }
  ],
  "$comment": "Code must additionally check unique entry IDs/slugs; unique source IDs; every sourceId resolves; no path traversal; approved image rights and existence; real reviewer identity/approval; factual support and date precision. Schema validation cannot verify historical truth, source quality, or ownership."
}
