{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BONG canned idea corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "datasetId",
    "sourceSha256",
    "categories",
    "ideas"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "datasetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      }
    },
    "ideas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "categoryId",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^BONG-[0-9]{4}$"
          },
          "categoryId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          }
        }
      }
    }
  },
  "$comment": "Application validation must also enforce unique IDs, referenced category existence, no control characters, exact initial 1000-row manifest, and source-to-JSON text equality. JSON Schema alone cannot check these relations."
}
