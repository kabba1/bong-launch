# Copy locally to .env.local; enter secrets through the deployment secret manager.
# Blank values are intentional. No sample credential grants access.
APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3210

# Public BONG v1 needs only APP_ENV and APP_ORIGIN. All services below are deferred.
# Master switch: leave false for v1, even if future service credentials are present.
COMMUNITY_ENABLED=false

# Separate restricted SQL credentials. Remote TLS validates the provider certificate.
BONG_DATABASE_URL=
BONG_MAINTENANCE_DATABASE_URL=
BONG_DATABASE_CA_CERT=
# Owner CLI only. Never place this credential in the deployed application environment.
BONG_OWNER_DATABASE_URL=
# Migration CLI/CI only. Never place this credential in the deployed application environment.
BONG_MIGRATION_DATABASE_URL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Narrow private Storage adapter; unavailable to the browser or ordinary SQL operations.
SUPABASE_STORAGE_SERVICE_KEY=
# Maintenance/owner Auth administration; use separate secret-store access controls.
SUPABASE_AUTH_ADMIN_KEY=
SUPABASE_MEDIA_BUCKET=
SUPABASE_EXPORT_BUCKET=

# Independent random secrets, at least 32 bytes each. Never use fixed example values.
CSRF_SECRET=
RATE_LIMIT_SECRET=
LOG_HMAC_SECRET=
MAINTENANCE_TOKEN=

# Provider CAPTCHA must be configured at Supabase Auth itself.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PROVIDER_CAPTCHA_ENABLED=false

# Safe launch state: all participation closed until actual owner/release gates pass.
REGISTRATIONS_ENABLED=false
POSTING_ENABLED=false
UPLOADS_ENABLED=false
REVIEW_ALL_SUBMISSIONS=true
COMMUNITY_RULES_VERSION=
TERMS_VERSION=

# Optional security.txt expiry (ISO 8601). No security.txt is published without a real contact.
SECURITY_TXT_EXPIRES=

# Other deployment/public metadata belongs in reviewed content configuration.
# VERCEL is set by the deployment platform. Do not set it on an untrusted proxy.
